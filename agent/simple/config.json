{
    "agent": {
        "version": "1.0.1",
        "questionBufferSize": 10,
        "logPath": "app/agentLogs/agent-%s.log",
        "prompt": {
            "paths": [
                "prompt.md"
            ],
            "bufferSizeInKB": 10
        },
        "tool": [
            {
                "name": "filewriter",
                "schema": "filewriter.schema.json",
                "decription": "Write content to a specified file path. Creates the file if it does not exist, or overwrites it if it does."
            },
            {
                "name": "getdate",
                "schema": "getdate.schema.json",
                "decription": "Get system current date and time."
            }
        ]
    },
    "session": {
        "logPath": "app/sessionLogs/session-%s.log",
        "reActMaxRounds": 10,
        "maxRetryOnLock": 3,
        "memoryFilePathFormat": "app/sessionMemories/session-%s-memory.jsonl"
    }
}