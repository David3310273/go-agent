{
    "agent": {
        "version": "1.0.1",
        "questionBufferSize": 10,
        "logPath": "app/agentLogs/agent-%s.log",
        "skill": [
            {
                "name": "helloworld",
                "description": "Get current time, and write content with that to a specified file path. Creates the file if it does not exist",
                "tools": ["WriteToFile", "GetDate"]
            },
            {
                "name": "searchkb",
                "description": "search knowledge base for the knowledge about technology or algorithms field",
                "tools": ["SearchKnowledgeBase"]
            }
        ],
        "prompt": {
            "paths": [
                "prompt.md"
            ],
            "bufferSizeInKB": 10
        },
        "knowledgeBase": [
            {
                "domain": "technology",
                "description": "Knowledge about programming and algorithms",
                "storageOptions": {
                    "type": "[Your storage type]",
                    "dbName": "[Your db name]",
                    "collection": "[Your collection name]",
                    "partitionName": ""
                }
            }
        ],
        "tool": [
            {
                "name": "UseSkill",
                "schema": "useskill.schema.json",
                "description": "load skill in agent when you want to do something"
            }
        ]
    },
    "session": {
        "logPath": "app/sessionLogs/session-%s.log",
        "reActMaxRounds": 10,
        "maxRetryOnLock": 3,
        "memoryWindowSize": 10000,
        "memoryFileSplitter": "\n--------------\n",
        "memoryFilePathFormat": "app/sessionMemories/session-%s-memory.jsonl",
        "promptFileMaxSize": 10
    }
}